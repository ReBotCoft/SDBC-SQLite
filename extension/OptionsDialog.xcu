        <node oor:name="dev.rebotcoft.sdbc.pysqlite.integrity" oor:op="fuse">
          <prop oor:name="Id" oor:type="xs:string">
            <value>dev.rebotcoft.sdbc.pysqlite</value>
          </prop>
          <prop oor:name="Label">
            <value xml:lang="en-US">Integrity and transactions</value>
