<?xml version="1.0" encoding="UTF-8"?>
<oor:component-data
  xmlns:oor="http://openoffice.org/2001/registry"
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  oor:package="org.openoffice.Office"
  oor:name="Addons">
  <node oor:name="AddonUI">
    <node oor:name="OfficeMenuBarMerging">
      <node oor:name="dev.rebotcoft.sdbc.pysqlite" oor:op="replace">
        <node oor:name="S1" oor:op="replace">
          <prop oor:name="MergePoint">
            <value>.uno:EditMenu\.uno:DBDatabasePropertiesMenu\.uno:DBDSAdvancedSettings</value>
          </prop>
          <prop oor:name="MergeCommand">
            <value>AddAfter</value>
          </prop>
          <prop oor:name="MergeFallback">
            <value>Ignore</value>
          </prop>
          <prop oor:name="MergeContext">
            <value></value>
          </prop>
          <node oor:name="MenuItems">
            <node oor:name="M1" oor:op="replace">
              <prop oor:name="URL" oor:type="xs:string">
                <value>dev.rebotcoft.sdbc.pysqlite:Settings</value>
              </prop>
              <prop oor:name="Title" oor:type="xs:string">
                <value xml:lang="en-US">PySQLite settings...</value>
                <value xml:lang="it">Impostazioni PySQLite...</value>
              </prop>
              <prop oor:name="Target" oor:type="xs:string">
                <value>_self</value>
              </prop>
              <prop oor:name="Context" oor:type="xs:string">
                <value></value>
              </prop>
            </node>
          </node>
        </node>
      </node>
    </node>
  </node>
</oor:component-data>
